    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.1",
